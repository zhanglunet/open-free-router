{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-free-router",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-01",
  "routes": [
    {
      "pattern": "oaf.asia",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "DISCOVERY",
      "id": "19ad870a7eb244ba91fb7f5ea08d9bb3"
    }
  ],
  // 只留一条 cron。Workers **Free** 档的触发器额度是「每账号 5 条」，账号已经占满，
  // 而本 Worker 原本一个人占了 2 条，别的项目因此配不上定时任务。
  // 目录与基准刷新已折进下面这条 `*/15` 的整点格（见 worker/index.js 的 isSixHourlySlot），
  // 仍是每 6 小时一次、每天 4 次，只是触发时刻从 :17 移到 :00。
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "secrets": {
    "required": [
      "OFR_PROBE_DEEPSEEK_API_KEY",
      "OFR_PROBE_GOOGLE_AI_STUDIO_API_KEY",
      "OFR_PROBE_GROQ_API_KEY",
      "OFR_PROBE_NVIDIA_NIM_API_KEY",
      "OFR_PROBE_NOUS_API_KEY",
      "OFR_PROBE_POOLSIDE_API_KEY",
      "OFR_PROBE_OPENROUTER_API_KEY",
      "OFR_PROBE_SENSENOVA_API_KEY",
      "OFR_PROBE_STEPFUN_API_KEY",
      "OFR_PROBE_GITEE_AI_API_KEY",
      "ARTIFICIAL_ANALYSIS_API_KEY",
      "INTERNAL_BENCHMARKS_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
